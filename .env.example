# Reference only: export these variables or configure them in your IDE.
# Spring Boot does not load .env automatically.
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/news_management?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=news_app
DB_PASSWORD=replace_with_local_mysql_password
# Set a random secret of at least 32 bytes before implementing JWT in Phase 3.
JWT_SECRET=replace_with_random_secret_of_at_least_32_bytes
JWT_EXPIRATION_MS=3600000
UPLOAD_DIR=./uploads
APP_BASE_URL=http://localhost:8080
